# NODE_ENV=development
# PORT=3000
# DJUBO_BASE_URL=https://www.secure-booking-engine.com/djubo-direct
# # Raw access token or DJUBO-TOKEN-prefixed token. The gateway normalizes the header.
# # Never copy tokens from source control. Obtain a newly issued credential.
# DJUBO_AUTH_TOKEN=
# DJUBO_API_VERSION=9
# DJUBO_SOURCE_ID=105
# DJUBO_SUB_SOURCE_ID=110
# DJUBO_LANGUAGE=en_US
# # Optional DJUBO availability context; configure when issued by DJUBO.
# DJUBO_QUERY_KEY=
# DJUBO_DEFAULT_CURRENCY=INR
# DJUBO_USER_COUNTRY=INDIA
# DJUBO_DEVICE_TYPE=Desktop
# # Optional DJUBO availability context; configure when issued by DJUBO.
# DJUBO_AVAILABILITY_ID=
# # Operational settings remain environment-specific.
# DJUBO_TIMEOUT_MS=10000
# DJUBO_READ_RETRIES=2
# DJUBO_MAX_CONCURRENCY=20
